# Copy to deploy/.env (git-ignored).

# Public host of the connector. The endpoint users paste is https://MCP_DOMAIN/mcp.
# DNS only (grey cloud) like the API: a two-level name is not covered by Cloudflare's Universal SSL; Caddy gets the certificate.
MCP_DOMAIN=mcp.tulsicrm.tdmgroups.com

# 32+ random characters: openssl rand -hex 32
# Back it up with the volume. Changing it disconnects everyone (they just sign in again).
CONNECTOR_SECRET=

# Which changes assistants may prepare (always as a draft the user confirms).
# low,normal = notes, follow-ups, leads, tasks, leave applications, assignments.
# Add ",high" to also allow stock adjustments, products, leave approval, targets,
# deletes, attendance check-in/out and WhatsApp sends.
WRITE_LEVELS=low,normal,high

# Only if the backend is reached differently:
# API_URL=http://backend:3000
