{
  "_readme": "Human parts of the catalog. scripts/build-catalog.js merges this into actions.json; re-running never loses it. Keys are \"METHOD /path\" exactly as the generator prints them. risk: low | normal | high | blocked (blocked = never exposed). WRITE_LEVELS on the connector decides which risks are usable (default low,normal).",
  "excludeRules": [
    {
      "match": "^\\w+ /auth/",
      "reason": "sign-in route (the connector's sign-in page handles it)"
    },
    {
      "match": "^\\w+ /whatsapp/debug",
      "reason": "debug route"
    },
    {
      "match": "^\\w+ /integrations/whatsapp",
      "reason": "integration setup (takes or shows WhatsApp/Meta secrets)"
    },
    {
      "match": "^\\w+ /platform-integrations",
      "reason": "integration setup (webhook URLs and sheet links are secrets)"
    },
    {
      "match": "^\\w+ /settings/",
      "reason": "org settings (admin screens only)"
    },
    {
      "match": "^\\w+ /cities",
      "reason": "org settings (admin map/spelling fixes)"
    },
    {
      "match": "^\\w+ /notifications/push/",
      "reason": "browser push setup (device only)"
    },
    {
      "match": "^PATCH /employees/me/(email|password)$",
      "reason": "session-only: takes the user's password"
    },
    {
      "match": "^(POST|PATCH|DELETE) /(users|managers|manager/team-members)(/|$)",
      "reason": "user management (blocked in v1: creates, changes or removes logins)"
    },
    {
      "match": "^PATCH /employees/:id/employee-code$",
      "reason": "user management (blocked in v1)"
    },
    {
      "match": "^POST /leads/(bulk-assign|bulk-delete|lost/shuffle)$",
      "reason": "bulk operation (blocked)"
    },
    {
      "match": "^\\w+ /leads/imports",
      "reason": "lead imports (Excel uploads are handled in the app)"
    },
    {
      "match": "^(PATCH /leads/seen|GET /leads/unseen-count|POST /leads/:leadId/whatsapp/read)$",
      "reason": "app-only screen state (new-lead dot, chat read marks)"
    }
  ],
